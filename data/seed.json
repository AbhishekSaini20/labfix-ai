  "knowledge": [
    {
      "category": "network",
      "id": "KB-N01",
      "title": "Device network checks",
      "steps": [
        "Check whether the network cable is visibly connected.",
        "Record the displayed network error and report it to the technician."
      ]
    },
    {
      "category": "network",
      "id": "KB-N02",
      "title": "Possible lab network incident",
      "steps": [
        "Ask whether other devices in the same lab are affected.",
        "Refer router and switch changes to the network technician."
      ]
    },
    {
      "category": "display",
      "id": "KB-D01",
      "title": "Projector checks",
      "steps": [
        "Check that the projector is powered on.",
        "Check the selected input source and visible display cable connection."
      ]
    },
    {
      "category": "display",
      "id": "KB-D02",
      "title": "Display evidence",
      "steps": [
        "Record any error message or indicator light for the technician."
      ]
    },
    {
      "category": "software",
      "id": "KB-S01",
      "title": "Missing software",
      "steps": [
        "Record the application name and required version.",
        "Ask the software technician to use the institution-approved installer."
      ]
    },
    {
      "category": "software",
      "id": "KB-S02",
      "title": "Application errors",
      "steps": [
        "Record the exact error message and the action that triggered it."
      ]
    },
    {
      "category": "hardware",
      "id": "KB-H01",
      "title": "Peripheral check",
      "steps": [
        "Record which keyboard or mouse is affected and whether its cable is visibly connected."
      ]
    },
    {
      "category": "hardware",
      "id": "KB-H02",
      "title": "Power issue",
      "steps": [
        "Record the power indicator state.",
        "Refer power-supply or internal component work to the technician."
      ]
    }
  ],
